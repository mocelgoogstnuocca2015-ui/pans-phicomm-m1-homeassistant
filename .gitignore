# 公开库采用白名单；本地 SDK、密码、Flash 备份、日志与第三方固件一律不跟踪。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/CONTRIBUTING.md
!/docs/
!/scripts/
!/.github/
!/m1_moc_firmware/

/m1_moc_firmware/*
!/m1_moc_firmware/*.c
!/m1_moc_firmware/*.h
!/m1_moc_firmware/m1_moc_firmware.mk
!/m1_moc_firmware/README.md
!/m1_moc_firmware/tests/
!/m1_moc_firmware/tools/
/m1_moc_firmware/tests/*
!/m1_moc_firmware/tests/parser_host_test.c
!/m1_moc_firmware/tests/scan_host_test.cjs
!/m1_moc_firmware/tests/release_tools_test.py
/m1_moc_firmware/tools/*
!/m1_moc_firmware/tools/pack_compatible_ota.py
!/m1_moc_firmware/tools/patch_captive_dhcp_kernel.py
!/m1_moc_firmware/tools/create_ota_command.py
!/m1_moc_firmware/tools/create_ha_update_discovery.py

__pycache__/
*.pyc
*.bin
*.elf
*.map
*.exe
*.zip
*.log
*.i64
*.idb
.env*
*password*.txt
*secret*.json
*.pem
*.key
